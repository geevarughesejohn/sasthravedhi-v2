# See https://help.github.com/articles/ignoring-files/

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build
/dist

# misc
.DS_Store
Thumbs.db
*.pem

# debug logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
*.log

# env files — never commit secrets
.env
.env.*
!.env.example

# local runtime data & membership submissions
/data/*.json
!/data/*.example.json

# vercel / deploy
.vercel

# typescript / caches
*.tsbuildinfo
.turbo/
.cache/

# editors & local tooling
.idea/
.vscode/
*.swp
*~
.cursor/

# OS
Desktop.ini
